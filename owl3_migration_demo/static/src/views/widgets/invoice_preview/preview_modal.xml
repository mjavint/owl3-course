<?xml version="1.0" encoding="utf-8"?>
<t t-name="owl3_migration_demo.PreviewModal">
    <!-- Directiva t-portal de Owl 2: el contenido se teletransporta a <body>. -->
    <div t-portal="'body'" class="o_invoice_preview">
        <h4>
            <t t-esc="props.title" />
        </h4>
        <div class="o_invoice_preview_body">
            <t t-slot="default" />
        </div>
        <button t-on-click="props.onClose" class="btn btn-secondary">Cerrar</button>
    </div>
</t>
