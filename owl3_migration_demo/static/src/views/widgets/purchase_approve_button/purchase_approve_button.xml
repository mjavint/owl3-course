<?xml version="1.0" encoding="utf-8"?>
<t t-name="owl3_migration_demo.PurchaseApproveButton">
    <button
        type="button"
        t-if="!props.readonly and this.isApprovable"
        t-on-click="() => this.onApprove()"
        class="btn btn-primary">
        <t t-esc="this.approvalLabel" />
    </button>
</t>
