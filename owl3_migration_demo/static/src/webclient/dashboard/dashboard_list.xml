<?xml version="1.0" encoding="utf-8"?>
<t t-name="owl3_migration_demo.DashboardList">
    <div class="o_dashboard_table">
        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="sticky-top bg-white">
                    <tr>
                        <th scope="col" style="width: 60px;">#</th>
                        <th scope="col">Pedido</th>
                        <th scope="col">Cliente</th>
                        <th scope="col" class="text-end">Importe</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="props.orders || []" t-as="order" t-key="order.id">
                        <tr
                            t-on-click="() => props.onSelect(order.id)"
                            class="cursor-pointer">
                            <td>
                                <t t-esc="order_index + 1" />
                            </td>
                            <td>
                                <t t-esc="order.name" />
                            </td>
                            <td>
                                <t t-esc="order.partner_id[1] ? order.partner_id[1] : ''" />
                            </td>
                            <td class="text-end">
                                <t t-esc="order.amount_total || 0.0" />
                            </td>
                        </tr>
                    </t>
                    <tr t-if="!props.orders.length">
                        <td colspan="4" class="text-center text-muted py-3">Sin pedidos.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</t>
