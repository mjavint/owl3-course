<?xml version="1.0" encoding="utf-8"?>
<t t-name="owl3_migration_demo.SearchInput">
    <!-- Input "controlado": el valor viene del padre y cada tecla sale por onInput. -->
    <div class="o_search_input input-group input-group-lg mb-3 shadow-sm rounded-pill overflow-hidden">
        <!-- Icono de búsqueda -->
        <span class="input-group-text bg-white border-end-0 text-muted ps-3">
            <i class="fa fa-search" />
        </span>
        <!-- Input -->
        <input
            t-att-placeholder="props.placeholder || 'Buscar pedido...'"
            t-att-value="props.value || ''"
            t-on-input="onInput"
            t-ref="input"
            type="text"
            class="form-control border-start-0 border-end-0 shadow-none ps-2"
            aria-label="Buscar" />
        <!-- Botón limpiar con icono -->
        <button
            t-att-class="'btn btn-link text-muted px-3 ' + (props.value ? '' : 'invisible')"
            t-on-click="clear"
            type="button"
            title="Limpiar búsqueda">
            <i class="fa fa-times-circle" />
        </button>
    </div>
</t>
