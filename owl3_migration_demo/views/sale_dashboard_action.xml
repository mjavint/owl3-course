<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Client action: dashboard de ventas (se pinta con un componente Owl).
         El `tag` debe coincidir EXACTAMENTE con la clave del registry:
         registry.category("actions").add("owl3_migration_demo.sale_dashboard", Comp)
         Esto NO cambia entre Odoo 19 y Odoo 20. -->
    <record id="action_sale_dashboard" model="ir.actions.client">
        <field name="name">Dashboard de ventas (Owl)</field>
        <field name="tag">owl3_migration_demo.sale_dashboard</field>
    </record>

    <menuitem id="menu_sale_dashboard_root"
              name="Demo Owl 3"
              sequence="90"/>

    <menuitem id="menu_sale_dashboard"
              name="Dashboard de ventas"
              parent="menu_sale_dashboard_root"
              action="action_sale_dashboard"
              sequence="10"/>

</odoo>
