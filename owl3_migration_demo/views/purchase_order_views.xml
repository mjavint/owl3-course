<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista formulario de compras: añade el campo de presupuesto y el botón de aprobación
         (view widget "purchase_approve_button"). El botón decide pintarse o no en función
         de `props.record.data.owl3_requires_approval`, presente en el arch. -->
    <record id="view_purchase_order_form_owl3_demo" model="ir.ui.view">
        <field name="name">purchase.order.form.owl3.demo</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="owl3_budget_limit" readonly="0" />
            </xpath>
            <xpath expr="//header" position="inside">
                <field name="owl3_requires_approval" invisible="1" />
                <widget name="budget_button" />
                <widget name="purchase_approve_button" />
            </xpath>
        </field>
    </record>
</odoo>
